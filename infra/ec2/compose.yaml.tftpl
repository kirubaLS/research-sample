name: yaadhum

services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: yaadhum
      POSTGRES_USER: yaadhum
      POSTGRES_PASSWORD: $${POSTGRES_PASSWORD}
    volumes:
      - /var/lib/yaadhum/postgres:/var/lib/postgresql/data
    # No ports. The database is reachable on the compose network and nowhere else, which
    # is why the security group has no 5432 rule to get wrong.
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U yaadhum -d yaadhum"]
      interval: 10s
      timeout: 5s
      retries: 10

  api:
    image: ${repository_url}:$${IMAGE_TAG:-latest}
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      PORT: "8000"
      YAADHUM_ENVIRONMENT: ${environment}
      YAADHUM_DATABASE_URL: postgresql+psycopg://yaadhum:$${POSTGRES_PASSWORD}@db:5432/yaadhum
      YAADHUM_MIGRATION_DATABASE_URL: postgresql+psycopg://yaadhum:$${POSTGRES_PASSWORD}@db:5432/yaadhum
      # Credentials come from the instance role, so there is no access key anywhere.
      YAADHUM_STORAGE_BACKEND: s3
      YAADHUM_S3_BUCKET: ${bucket}
      YAADHUM_S3_REGION: ${region}
      YAADHUM_CORS_ORIGINS: $${YAADHUM_CORS_ORIGINS}
      YAADHUM_TRUSTED_HOSTS: $${YAADHUM_TRUSTED_HOSTS}
      YAADHUM_ANTHROPIC_API_KEY: $${YAADHUM_ANTHROPIC_API_KEY:-}
      YAADHUM_JINA_API_KEY: $${YAADHUM_JINA_API_KEY:-}
      YAADHUM_PLATFORM_ADMIN_KEY: $${YAADHUM_PLATFORM_ADMIN_KEY:-}
    # The image migrates and then serves. One instance, so nothing can race it.
    expose:
      - "8000"

  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    depends_on: [api]
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/yaadhum/Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/lib/yaadhum/caddy:/data
