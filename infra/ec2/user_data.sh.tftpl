#!/usr/bin/env bash
#
# First boot. Everything here is idempotent, because it also runs after a stop/start.
set -euxo pipefail

dnf -y update
dnf -y install docker awscli postgresql16
systemctl enable --now docker

# The compose plugin is not packaged on Amazon Linux 2023.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-$(uname -s)-$(uname -m)" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# The data volume, formatted only if it is blank. mkfs on a volume that already holds a
# school's marks is the one command here that could not be undone.
DEVICE=$(readlink -f /dev/sdf || echo /dev/nvme1n1)
if ! blkid "$DEVICE"; then
  mkfs -t xfs "$DEVICE"
fi
mkdir -p /var/lib/yaadhum
grep -q /var/lib/yaadhum /etc/fstab || echo "UUID=$(blkid -s UUID -o value "$DEVICE") /var/lib/yaadhum xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
mkdir -p /var/lib/yaadhum/postgres /var/lib/yaadhum/caddy

mkdir -p /opt/yaadhum
cat > /opt/yaadhum/compose.yaml <<'COMPOSE'
${compose}
COMPOSE

cat > /opt/yaadhum/Caddyfile <<'CADDY'
${caddyfile}
CADDY

# Settings come from Secrets Manager on every boot, so rotating one is a restart rather
# than a rebuild, and nothing sensitive is ever written into user data.
cat > /usr/local/bin/yaadhum-env <<'ENVSH'
#!/usr/bin/env bash
set -euo pipefail
aws secretsmanager get-secret-value --secret-id "${app_secret}" --region "${region}" \
  --query SecretString --output text > /opt/yaadhum/.env.tmp
chmod 600 /opt/yaadhum/.env.tmp
mv /opt/yaadhum/.env.tmp /opt/yaadhum/.env
ENVSH
chmod +x /usr/local/bin/yaadhum-env

cat > /usr/local/bin/yaadhum-up <<'UPSH'
#!/usr/bin/env bash
set -euo pipefail
/usr/local/bin/yaadhum-env
aws ecr get-login-password --region "${region}" \
  | docker login --username AWS --password-stdin "${registry}"
cd /opt/yaadhum
docker compose pull
docker compose up -d --remove-orphans
docker image prune -f
UPSH
chmod +x /usr/local/bin/yaadhum-up

cat > /etc/systemd/system/yaadhum.service <<'UNIT'
[Unit]
Description=Yaadhum
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/yaadhum-up
ExecStop=/usr/bin/docker compose -f /opt/yaadhum/compose.yaml down

[Install]
WantedBy=multi-user.target
UNIT

# --- backups -----------------------------------------------------------------------------
# A dump a day to S3. The instance may write one and may not delete one: retention is the
# bucket's lifecycle rule, so a mistake here cannot remove the history.
cat > /usr/local/bin/yaadhum-backup <<'BACKUPSH'
#!/usr/bin/env bash
set -euo pipefail
set -o pipefail
source /opt/yaadhum/.env
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
docker compose -f /opt/yaadhum/compose.yaml exec -T db \
  pg_dump -U yaadhum -d yaadhum --format=custom \
  | gzip -9 \
  | aws s3 cp - "s3://${bucket}/backups/yaadhum-$${STAMP}.dump.gz" --region "${region}"
echo "backed up to s3://${bucket}/backups/yaadhum-$${STAMP}.dump.gz"
BACKUPSH
chmod +x /usr/local/bin/yaadhum-backup

cat > /etc/systemd/system/yaadhum-backup.service <<'UNIT'
[Unit]
Description=Yaadhum database backup to S3
[Service]
Type=oneshot
ExecStart=/usr/local/bin/yaadhum-backup
UNIT

cat > /etc/systemd/system/yaadhum-backup.timer <<'UNIT'
[Unit]
Description=Daily Yaadhum backup
[Timer]
# 19:30 UTC is 01:00 IST: after the school day, before anybody is in.
OnCalendar=*-*-* 19:30:00
Persistent=true
[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now yaadhum.service
systemctl enable --now yaadhum-backup.timer
