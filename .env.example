# ── Environment ───────────────────────────────────────────────────────────────────────
YAADHUM_ENVIRONMENT=development          # development | staging | production

# Read by docker-compose.yml's `postgres` service directly (not by the app itself, which
# gets the full connection string via YAADHUM_DATABASE_URL below). Only used under Compose
# -- see infra/README.md.
POSTGRES_PASSWORD=

# ── Storage ───────────────────────────────────────────────────────────────────────────
# SQLite works out of the box. A managed 'postgres://' URL is normalised automatically.
YAADHUM_DATABASE_URL=postgresql+psycopg://yaadhum:yaadhum@localhost:5432/yaadhum
# On Neon, DATABASE_URL is the POOLED endpoint (hostname contains "-pooler") and this is
# the DIRECT one. Alembic needs the direct endpoint: the locks a migration relies on do not
# survive PgBouncer transaction pooling. Leave blank when there is no pooler.
YAADHUM_MIGRATION_DATABASE_URL=
YAADHUM_DB_POOL_SIZE=5
YAADHUM_DB_MAX_OVERFLOW=5
# ml_corpus gets its own credentials: the training pipeline must never write to
# operational tables.
YAADHUM_CORPUS_DATABASE_URL=postgresql+psycopg://corpus:corpus@localhost:5432/yaadhum_corpus

# Object store: 'local' for a laptop, 's3' for anything real (AWS S3, Cloudflare R2, MinIO).
YAADHUM_STORAGE_BACKEND=local
YAADHUM_OBJECT_STORE_ROOT=./var/objects
# Student page images contain children's handwriting — keep the bucket in India.
YAADHUM_S3_REGION=ap-south-1
YAADHUM_S3_BUCKET=
YAADHUM_S3_ENDPOINT_URL=                 # set for Cloudflare R2 or MinIO; blank for AWS
YAADHUM_S3_ACCESS_KEY_ID=
YAADHUM_S3_SECRET_ACCESS_KEY=

# ── Web ───────────────────────────────────────────────────────────────────────────────
# Exact origins, comma separated. NEVER '*': /t/{class_code}/start is unauthenticated.
YAADHUM_CORS_ORIGINS=http://localhost:3000
YAADHUM_TRUSTED_HOSTS=*
YAADHUM_PUBLIC_RATE_LIMIT_PER_HOUR=60

# ── Models ────────────────────────────────────────────────────────────────────────────
# Pay by stakes: the best model runs once per paper, the cheap one runs 1,200 times.
YAADHUM_MODEL_HIGH_STAKES=claude-opus-5
YAADHUM_MODEL_HIGH_VOLUME=claude-haiku-4-5
YAADHUM_ANTHROPIC_API_KEY=

# ── Accuracy posture ──────────────────────────────────────────────────────────────────
YAADHUM_AUTO_ACCEPT_THRESHOLD=0.97
YAADHUM_CONFORMAL_ALPHA=0.05
YAADHUM_EVIDENCE_FLOOR_MARKS=2

# ── Cost / accuracy levers (all off by default; see docs/cost-accuracy-strategy.md) ────
# Tier 0 chapter gate. SHADOW first: the chapter judge is still asked, and each place job
# reports how often retrieval alone agreed with it (python -m scripts.tune_gate picks the margin).
YAADHUM_CHAPTER_GATE=false
YAADHUM_CHAPTER_GATE_ENFORCE=false      # only after the shadow agreement rate is read
YAADHUM_CHAPTER_GATE_MIN_MARGIN=0.3
YAADHUM_CHAPTER_GATE_RERANKER=false     # Jina cross-encoder as the gate's third reader
# Confirmed-question memory: recall observes; reuse skips both judges on a near-identical
# question a teacher already confirmed in this school; demos shows the judge worked examples.
YAADHUM_MEMORY_RECALL=false
YAADHUM_MEMORY_REUSE=false
YAADHUM_MEMORY_MIN_SIMILARITY=0.9
YAADHUM_MEMORY_DEMOS=0
# Chapter judge: several questions per call, and a reordered re-ask of low-confidence answers.
YAADHUM_CHAPTER_JUDGE_GROUP_SIZE=1
YAADHUM_CHAPTER_RECHECK=false
YAADHUM_CHAPTER_RECHECK_BELOW=0.8
YAADHUM_CHAPTER_RECHECK_N=2
# Naive-Bayes chapter classifier (trained on the book + confirmed questions) as a gate reader.
YAADHUM_CHAPTER_GATE_CLASSIFIER=false
YAADHUM_CHAPTER_GATE_CLASSIFIER_MIN=0.9
# Index each chunk with its chapter title and section reference (contextual retrieval, no LLM).
YAADHUM_RETRIEVAL_CONTEXTUAL_PREFIX=false
# Topic judge: skip the second read when the first is corroborated.
YAADHUM_TOPIC_ADAPTIVE_READS=false
# Chapter judge through the Batches API too (half price; adds a batch wait).
YAADHUM_BATCH_CHAPTER_JUDGE=false
# Scanned papers: read with this cheaper model first, escalate if the paper's own total or
# count is not reproduced. Empty = every page by YAADHUM_MODEL_HIGH_STAKES.
YAADHUM_VISION_CHEAP_MODEL=

# ── Frontend ──────────────────────────────────────────────────────────────────────────
# Next inlines NEXT_PUBLIC_* at BUILD time. Changing it needs a rebuild, not a restart.
NEXT_PUBLIC_API_BASE=http://localhost:8000
